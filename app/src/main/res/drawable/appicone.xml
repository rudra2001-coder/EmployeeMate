<?xml version="1.0" encoding="utf-8"?>
<svg xmlns:tools="http://schemas.android.com/tools"
    xmlns="http://www.w3.org/2000/svg"
    width="1024" height="1024" viewBox="0 0 1024 1024"
    role="img" aria-label="Employee Management App Logo" >


    <!-- Transparent background (no box) -->
    <g transform="translate(64,64) scale(0.875)">
        <!-- Clipboard body -->
        <rect x="96" y="128" rx="56" ry="56" width="640" height="704"
            fill="var(--primary)" />

        <!-- Clipboard top tab (paper clip tab) -->
        <rect x="304" y="40" rx="24" ry="24" width="256" height="112"
            fill="var(--primary)" />

        <!-- Inner panel (slightly inset to create 'paper' feel) -->
        <rect x="144" y="192" rx="36" ry="36" width="576" height="592"
            fill="rgba(255,255,255,0.12)" />

        <!-- Left circular badge for checkmark -->
        <circle cx="300" cy="460" r="110" fill="var(--onPrimary)" />

        <!-- Checkmark (white) -->
        <path d="M252 460
             l44 44
             l120 -140"
            fill="none" stroke="var(--primary)" stroke-width="44"
            stroke-linecap="round" stroke-linejoin="round" />

        <!-- Right small clock overlapping clipboard -->
        <g transform="translate(560,440)">
            <circle cx="0" cy="0" r="96" fill="var(--onPrimary)" />
            <!-- clock hands -->
            <path d="M0 -12 L0 28" stroke="var(--primary)" stroke-width="18" stroke-linecap="round"/>
            <path d="M0 0 L32 -18" stroke="var(--primary)" stroke-width="18" stroke-linecap="round"/>
            <!-- small center hub -->
            <circle cx="0" cy="0" r="8" fill="var(--primary)"/>
        </g>

        <!-- Subtle rounded shadow stroke for contrast on both backgrounds -->
        <rect x="96" y="128" rx="56" ry="56" width="640" height="704"
            fill="none" stroke="rgba(0,0,0,0.06)" stroke-width="6" />

    </g>
</svg>
